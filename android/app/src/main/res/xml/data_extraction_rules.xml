<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer (Android 12+); backup_rules.xml is the older equivalent.
   The flash dumps stay out: they are Casio's firmware (the user's own copy) and, at
   16-32 MB, also over the 25 MB cloud-backup quota. Sessions and settings are kept.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="flash_dump.bin" />
        <exclude domain="external" path="flash_dump.bin.part" />
        <exclude domain="external" path="flash_full_32mb.bin" />
        <exclude domain="external" path="flash_full.bin" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="flash_dump.bin" />
        <exclude domain="external" path="flash_dump.bin.part" />
        <exclude domain="external" path="flash_full_32mb.bin" />
        <exclude domain="external" path="flash_full.bin" />
    </device-transfer>
</data-extraction-rules>
