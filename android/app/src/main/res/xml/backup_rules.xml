<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup (Android 11 and older; data_extraction_rules.xml is used from Android 12).
   The flash dumps stay out of backups: they are Casio's firmware (the user's own copy) and,
   at 16-32 MB, also over the 25 MB backup quota. The sessions (save-states) and settings
   are backed up.
-->
<full-backup-content>
    <exclude domain="external" path="flash_dump.bin" />
    <exclude domain="external" path="flash_dump.bin.part" />
    <exclude domain="external" path="flash_full_32mb.bin" />
    <exclude domain="external" path="flash_full.bin" />
</full-backup-content>
